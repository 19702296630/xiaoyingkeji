# ============== 示例配置模板 ==============
# 使用方法：复制本文件为 .env，再填入你自己的真实配置
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交；请勿把真实密钥写回本文件。

# ============== 数据库配置 ==============
# PostgreSQL 连接字符串 (用于 SQLAlchemy AsyncIO)
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@localhost:5432/aicontent

# PostgreSQL 连接字符串 (用于 psycopg3 / LangGraph Checkpointer)
POSTGRES_URI=postgresql://postgres:your_db_password@localhost:5432/aicontent

# Application Settings
APP_NAME=AI内容运营助手
DEBUG=true

# LLM Configuration (火山引擎 Doubao)
# 在此填写你的API Key
LLM_API_KEY=your_volcengine_api_key_here
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 标准模型 (文章写作用，需要高质量输出)
LLM_MODEL=doubao-seed-2-1-turbo-260628
LLM_TEMPERATURE=0.7

# 快速模型 (选题生成、配图要点提取用，追求速度)
LLM_MODEL_FAST=doubao-seed-2-1-turbo-260628
LLM_TEMPERATURE_FAST=0.7
LLM_TEMPERATURE_EXTRACT=0.4

# LangSmith 配置 (追踪与监控)
# 启用 LangSmith 追踪
LANGCHAIN_TRACING_V2=false
# 你的 LangSmith API Key（请替换为你的实际 key）
LANGCHAIN_API_KEY=your_langsmith_api_key_here
# 项目名称（在 LangSmith 中显示）
LANGCHAIN_PROJECT=xiaohongshu-content-assistant
# LangSmith 端点（官方默认端点）
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ============== JWT 认证配置 ==============
# 生产环境务必改成随机长字符串（可用 `openssl rand -hex 32` 生成）
JWT_SECRET_KEY=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ============== 日志配置 ==============
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志输出目标: file, loki, aliyun, volcengine
# 目前支持 file，后续可扩展云服务
LOG_TARGET=file

# 日志文件目录
LOG_DIR=logs

# 是否在控制台输出日志（开发时建议 true）
LOG_CONSOLE=false

# 控制台是否输出 JSON 格式（false 则彩色输出，开发友好）
LOG_JSON=false

# 是否启用 PII 脱敏（邮箱、信用卡、API Key、手机号）
LOG_PII_ANONYMIZE=true

# ============== 图片生成配置 (OpenAI 格式) ==============
# 图片生成 API Key
IMAGE_API_KEY=your_volcengine_api_key_here
# API 基础地址
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 图片生成模型
IMAGE_MODEL=doubao-seedream-5-0-pro-260628
